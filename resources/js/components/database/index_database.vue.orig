        { name: "Thursday", code: "Thursday" },
        { name: "Friday", code: "Friday" },
        { name: "Saturday", code: "Saturday" },
        { name: "Sunday", code: "Sunday" },
      ],
      dates: [],
      selectedDay: null,
      rbdSched: "rbd",
      isNotDaily: true,
      isNotMonthly: true,
      isNotWeekly: true,
      form: {
        logDays: 0,
        isDaily: 0,
