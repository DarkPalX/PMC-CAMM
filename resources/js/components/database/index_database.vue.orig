export default {
  props: ["databasetables"],
  data() {
    return {
      dashboard: this.$env_Url + "/dashboard",
      filters: null,
      databasetableLists: this.databasetables,
      form: {
        id: 0,
      },
      reindexMsg: "Application Reindex",
      syncMsg: "Application Sync",
      clearMsg: "Clear Logs",
