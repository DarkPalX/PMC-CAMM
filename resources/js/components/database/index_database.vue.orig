    <div>
      <h5>Clear Logs</h5>
      <div class="grid p-fluid" style="margin-bottom: 35px">
        <div class="col-12 md:col-4">
          <div class="p-inputgroup">
            <span class="p-inputgroup-addon">
              <i class="pi pi-calendar"></i>
