    };
  },
  created() {
    this.initFilters();
    this.loadDate();
    this.fetchSchedule();
  },
  methods: {
    initFilters() {
      this.filters = {
        global: { value: null, matchMode: FilterMatchMode.CONTAINS },
      };
    },

    clearFilter() {
      this.filters["global"].value = null;
    },

    async reindexApplication(data) {
      let src = data.data.id;
      this.form.id = data.data.id;
      const res = await this.submit("post", "/databases/reindex", this.form);
      if (res.status == 200) {
        this.reindexmessage();
        this.fetchApplications();
      } else {
        this.singleermessage(res.data.error);
      }
    },

    async shrinkApplication(data) {
      let src = data.data.id;
      this.form.id = data.data.id;
      const res = await this.submit("post", "/databases/shrink", this.form);
      if (res.status == 200) {
        this.shrinkmessage();
      } else {
        this.singleermessage(res.data.error);
      }
    },


    async syncApplication(data) {
      let src = data.data.id;
      this.form.id = data.data.id;
      // window.location.href = this.$env_Url + "/databases/sync/" + alt;
      const res = await this.submit("post", "/databases/sync", this.form);
      if (res.status == 200) {
        this.syncmessage();
        this.fetchApplications();
      } else {
        this.singleermessage(res.data.error);
      }
    },

    clearApplication(data) {
      let src = data.data.id,
        alt = data.data.id;
      window.location.href = this.$env_Url + "/databases/clear/" + alt;
      this.clearLogs();
    },

    exportCSV() {
      this.$refs.dt.exportCSV();
    },
    async fetchApplications() {
      const res = await this.callApi("get", "/databases/getApplications");
      this.databasetableLists = res.data;
    },
    setSchedule(data) {
      const schedule = this.schedules.filter((sched) => sched.application == data.data.description);
      this.form.apps = data.data.description;
      this.form.logDays = schedule[0].logDays;
      this.form.isDaily = schedule[0].isDaily;
      this.form.hrs = schedule[0].hrs;
      this.form.isWeekly = schedule[0].isWeekly;
      this.form.week_day = schedule[0].week_day;
      this.form.isMonthly = schedule[0].isMonthly;
      this.form.month_date = schedule[0].month_date;
      this.selectrdb();
      this.displaySchedule = true;
    },
    closeModal() {
      this.displaySchedule = false;
    },
    selectrdb() {
      this.isNotMonthly = true;
      this.isNotWeekly = true;
      this.isNotDaily = true;
      if (this.rbdSched == "rbm") {
        this.isNotMonthly = false;
      } else if (this.rbdSched == "rbw") {
        this.isNotWeekly = false;
      } else {
        this.isNotDaily = false;
      }
    },
    loadDate() {
      for (var i = 1; i <= 31; i++) {
        this.dates.push({ name: i, code: i });
      }
    },
    async createSchedule() {
      if (this.rbdSched == "rbm") {
        this.form.isMonthly = true;
        this.form.isDaily = false;
        this.form.isWeekly = false;
        this.form.hrs = 0;
        this.form.week_day = "";
      } else if (this.rbdSched == "rbw") {
        this.form.isWeekly = true;
        this.form.isDaily = false;
        this.form.isMonthly = false;
        this.form.hrs = 0;
        this.form.month_date = 0;
      } else {
        this.form.isDaily = true;
        this.form.isWeekly = false;
        this.form.isMonthly = false;
        this.form.week_day = "";
        this.form.month_date = 0;
      }
      const res = await this.submit("post", "/schedule/store", this.form, {
        headers: {
          "Content-Type":
            "multipart/form-data; charset=utf-8; boundary=" +
            Math.random().toString().substr(2),
        },
      });
      if (res.status === 200) {
        this.smessage();
        // this.displaySchedule = false;
        this.fetchSchedule();
      } else {
        this.ermessage(res.data.errors);
      }
    },
    async fetchSchedule() {
      const res = await this.callApi("get", "/schedule/getSchedule");
      this.schedules = res.data;
    },
  },
};
</script>